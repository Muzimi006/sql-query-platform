<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>sql-query-platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>sql-query-platform</name>
	<description>基于 Spring Boot 的在线 SQL 查询与审核平台</description>

	<!--
	  许可声明。⚠️ 它不只是"填个字段"：
	  ① 依赖治理工具（license-maven-plugin、企业内部的成分分析）读的就是这里；
	  ② 仓库根的 LICENSE 文件是给"人"看的，POM 里的是给"工具"看的 —— 两者必须一致。
	  选 Apache-2.0 的理由：企业最友好（含专利授权），而本项目依赖里
	  JSqlParser 是 Apache-2.0/LGPL-2.1 双许可、amqp-client 是 AL2/GPLv2/MPL2 三许可，
	  都可以取其中的 Apache-2.0，所以不存在兼容性障碍（见 NOTICE）。
	-->
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<properties>
		<java.version>17</java.version>
		<!-- 需要 MySQL / Redis / RabbitMQ 的用例统一打 integration 标签，默认排除。
		     写成属性（而不是把值直接写在插件里）是必须的：POM 里显式配置的插件参数
		     优先级高于命令行 -D 属性，硬编码后 README 里的
		     mvn test -Dgroups=integration 会被静默跳过，一条用例都不跑却显示 BUILD SUCCESS。
		     本地想跑集成测试：mvn test -Dgroups=integration -Dsurefire.excludedGroups= -->
		<surefire.excludedGroups>integration</surefire.excludedGroups>
	</properties>
	<!--
	  ⚠️ 这里**故意留空**：曾经用来覆盖 amqp-client 的版本（5.30.0 → 5.35.0），
	  现在交回 Spring Boot 管理。

	  为什么删掉（这是一次有据可查的决定，不是"清理"）：
	  ① 那个覆盖**没有写原因**，而作者也拿不出证据说明是 CVE 还是功能修复 ——
	     覆盖受管版本却不写原因，等于给未来埋一个「不敢碰、也说不清」的坑；
	  ② Spring Boot 4.1.0 的测试矩阵就是围绕它管理的 5.30.0 做的，
	     跟着受管版本走 = 跟着官方验证过的组合走；
	  ③ 升级 Boot 时依赖会**自动**跟上，不需要有人记得手动抬这个数字。

	  如果将来真的需要覆盖（查到了 CVE、或遇到了某个 issue），请：
	  把版本写进 <dependencyManagement>（不能写在直接依赖的 <version> 上，
	  否则依赖树里会同时存在两个版本、dependencyConvergence 会失败），
	  **并在这里写清 CVE 编号或 issue 链接**。

	  背景：maven-enforcer 的 dependencyConvergence 加上当天就抓出了「树里有两个 amqp-client」
	  （见 docs/开发规范.md §4 与问题修复档案 K-01）。
	-->

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- PostgreSQL 驱动。多方言支持的另一半：
		     只有 MySQL 驱动时，即使代码里拼出了 jdbc:postgresql:// 也会在运行期报
		     "No suitable driver"，而那是一个离根因很远的错误信息。 -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
			<version>3.5.6</version>
			<exclusions>
				<exclusion>
					<groupId>org.mybatis</groupId>
					<artifactId>mybatis-spring</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.mybatis</groupId>
			<artifactId>mybatis-spring</artifactId>
			<version>4.0.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<dependency>
			<groupId>com.auth0</groupId>
			<artifactId>java-jwt</artifactId>
			<version>4.4.0</version>
		</dependency>
		<!-- jsqlparser 的版本必须 >= MyBatis-Plus 声明的版本，这里锁 4.9。
		     MyBatis-Plus 3.5.6 的 mybatis-plus-core.pom 依赖的就是 4.9，
		     而 PaginationInnerInterceptor 的字节码里直接 new 了
		     net.sf.jsqlparser.statement.select.SelectItem。
		     该类型在 4.2/4.4/4.6 里是 interface、从 4.9 起才是 class ——
		     把版本压到 4.6 会让分页插件在实例化时抛
		     java.lang.InstantiationError: ...SelectItem，整个应用起不来。
		     这个失败只在"真的用了 PaginationInnerInterceptor"时才暴露，
		     所以曾经表现为"分页插件一加就崩"，而不是编译错误。 -->
		<dependency>
			<groupId>com.github.jsqlparser</groupId>
			<artifactId>jsqlparser</artifactId>
			<version>4.9</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<!-- jackson-databind 本身不含 java.time 支持，缺了它 LocalDateTime 无法序列化 -->
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>

		<!-- 不写版本：跟随 Spring Boot 管理的版本（4.1.0 管的是 5.30.0）。
		     代码里直接用到 com.rabbitmq.client.Channel（手动 ack 的消费者），
		     所以这个直接依赖是必要的、不是"顺手写的"；但版本交给 Boot。
		     为什么不覆盖：见文件上方 dependencyManagement 处的说明。 -->
		<dependency>
			<groupId>com.rabbitmq</groupId>
			<artifactId>amqp-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- 监控与指标。starter-actuator 负责暴露 /actuator/**，
		     micrometer-registry-prometheus 提供 /actuator/prometheus 这个抓取端点。
		     两个都要：只有 actuator 的话能看到指标名，但拿不到 Prometheus 格式的文本。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- 接口文档（OpenAPI 3 + Swagger UI）。
		     ⚠️ 版本必须跟 Spring Boot 的大版本走：springdoc 2.x 面向 Boot 3，
		     3.x 面向 Boot 4（3.1.1 的父 pom 就是 spring-boot-starter-parent:4.1.0）。
		     装 2.x 会以"Bean 创建失败 / 类找不到"的形式崩在启动阶段。
		     ⚠️ 它会暴露全部接口的面貌（路径、参数、DTO 字段），
		     而 /v3/api-docs 与 /swagger-ui 都不在 /api/** 下 —— 也就是**不受 JwtInterceptor 保护**。
		     生产部署请用 springdoc.api-docs.enabled=false 关掉，见 application.yml 的注释。 -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			  Maven Enforcer：把「这个项目需要什么环境」变成构建时就会失败的检查。
			
			  ⚠️ 为什么值得加：没有它的时候，用错 JDK / 用错 Maven 版本、
			  或者某个依赖树里出现两个版本的同名类，都只会在**运行到某一步**才以
			  「ClassNotFound / NoSuchMethodError / 行为诡异」的形式暴露 ——
			  而那时候没人会想到根因是构建环境。

			  requireJavaVersion 取 [17,)：与 pom 里的 java.version 一致，
			  但不写死上界 —— 用更高版本 JDK 编译应当被允许（实测 17 通过）。
			  dependencyConvergence 是这里面最有价值的一条：它要求同一个 artifact
			  在整棵依赖树里只能收敛到一个版本（详见 docs/开发规范.md）。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-build-environment</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[17,)</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
								<dependencyConvergence/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- 默认值来自 properties 里的 surefire.excludedGroups。
					     本地起好中间件后：mvn test -Dgroups=integration -Dsurefire.excludedGroups= -->
					<excludedGroups>${surefire.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
							<!--
							  只对**主源码**开 lint（testCompile 不加）。三类取舍都写在这里：
							
							  ① 为什么不是 -Xlint:all：all 会连带打开 -processing 与 -classfile，
							     实测 20 条输出里 13 条是纯噪音 —— 前者是"没有处理程序要使用以下任何注释"
							     （Lombok/Spring 注释必然如此），后者是依赖里的 kotlin.Metadata 造成的
							     "找不到注释方法"（不是我们的代码）。噪音多了，人就会学会忽略警告。
							  ② 为什么只给主源码开：测试源码有 38 条（几乎全是 Mockito 的 ArgumentCaptor
							     泛型转换、泛型数组创建这类写法），一起开等于长期挂着一屏黄。
							  ③ 为什么不用 -Werror：JDK 升级可能新增 lint 类别，不该因此让构建直接失败。
							
							  起因：SqlValidateUtil 里两处 JSqlParser 4.9 的 @Deprecated 调用（getTableList /
							  Statements.getStatements）在 IDE 里一直挂黄，而命令行构建完全看不见 ——
							  这类"只有 IDE 能看见"的警告最容易一直留着。打开之后它们立刻被列出来了。
							-->
							<compilerArgs>
								<arg>-Xlint:all,-processing,-classfile</arg>
							</compilerArgs>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
