<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>sql-query-platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>sql-query-platform</name>
	<description>基于 Spring Boot 的在线 SQL 查询与审核平台</description>
	<properties>
		<java.version>17</java.version>
		<!-- 需要 MySQL / Redis / RabbitMQ 的用例统一打 integration 标签，默认排除。
		     写成属性（而不是把值直接写在插件里）是必须的：POM 里显式配置的插件参数
		     优先级高于命令行 -D 属性，硬编码后 README 里的
		     mvn test -Dgroups=integration 会被静默跳过，一条用例都不跑却显示 BUILD SUCCESS。
		     本地想跑集成测试：mvn test -Dgroups=integration -Dsurefire.excludedGroups= -->
		<surefire.excludedGroups>integration</surefire.excludedGroups>
	</properties>
	<!--
	  依赖版本管理。

	  ⚠️ 覆盖 Spring Boot 受管版本的**正确位置是这里，不是直接依赖上的 <version>**：
	  写在直接依赖上时，Boot 通过 starter 传进来的那个版本仍然在依赖树里，
	  于是一棵树里出现两个版本 —— maven-enforcer 的 dependencyConvergence 会直接失败
	  （这条规则是有价值的：同名不同版本的类在运行时表现为诡异的 NoSuchMethodError）。
	  写进 dependencyManagement 之后，受管版本会把**所有**路径（含传递依赖）都收敛到同一个。
	-->
	<dependencyManagement>
		<dependencies>
			<!-- 覆盖 Spring Boot 4.1.0 管理的 amqp-client 版本（Boot 管理的是 5.30.0）。

			     ⚠️ 这里**缺一句原因**，而这是一个真实的风险、不是形式主义：
			     覆盖受管版本却不写原因，下一个人（包括半年后的自己）就不知道它能不能动 ——
			     升级 Boot 时只能在「不敢碰」和「赌一把删掉」之间二选一，两种都不是工程决策。

			     需要作者补写的内容（三条里挑一条并附证据）：
			     ① 安全修复：哪个 CVE、影响什么；
			     ② 功能修复：哪个 issue / 什么表现、本项目是否真的遇到过；
			     ③ 只是跟着升级：那就应该删掉这个覆盖，交回 Boot 管理。

			     在那之前，这个覆盖由 maven-enforcer 的 dependencyConvergence 保证
			     **只影响版本、不产生同名多版本**（这也是它被放进 dependencyManagement
			     而不是直接依赖上的原因）。 -->
			<dependency>
				<groupId>com.rabbitmq</groupId>
				<artifactId>amqp-client</artifactId>
				<version>5.35.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- PostgreSQL 驱动。多方言支持的另一半：
		     只有 MySQL 驱动时，即使代码里拼出了 jdbc:postgresql:// 也会在运行期报
		     "No suitable driver"，而那是一个离根因很远的错误信息。 -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot3-starter</artifactId>
			<version>3.5.6</version>
			<exclusions>
				<exclusion>
					<groupId>org.mybatis</groupId>
					<artifactId>mybatis-spring</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.mybatis</groupId>
			<artifactId>mybatis-spring</artifactId>
			<version>4.0.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<dependency>
			<groupId>com.auth0</groupId>
			<artifactId>java-jwt</artifactId>
			<version>4.4.0</version>
		</dependency>
		<!-- jsqlparser 的版本必须 >= MyBatis-Plus 声明的版本，这里锁 4.9。
		     MyBatis-Plus 3.5.6 的 mybatis-plus-core.pom 依赖的就是 4.9，
		     而 PaginationInnerInterceptor 的字节码里直接 new 了
		     net.sf.jsqlparser.statement.select.SelectItem。
		     该类型在 4.2/4.4/4.6 里是 interface、从 4.9 起才是 class ——
		     把版本压到 4.6 会让分页插件在实例化时抛
		     java.lang.InstantiationError: ...SelectItem，整个应用起不来。
		     这个失败只在"真的用了 PaginationInnerInterceptor"时才暴露，
		     所以曾经表现为"分页插件一加就崩"，而不是编译错误。 -->
		<dependency>
			<groupId>com.github.jsqlparser</groupId>
			<artifactId>jsqlparser</artifactId>
			<version>4.9</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<!-- jackson-databind 本身不含 java.time 支持，缺了它 LocalDateTime 无法序列化 -->
		<dependency>
			<groupId>com.fasterxml.jackson.datatype</groupId>
			<artifactId>jackson-datatype-jsr310</artifactId>
		</dependency>

		<!-- amqp-client 的版本在下面的 <dependencyManagement> 里统一覆盖（5.35.0），
		     这里刻意不写版本 —— 见那边的原因说明。 -->
		<dependency>
			<groupId>com.rabbitmq</groupId>
			<artifactId>amqp-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- 监控与指标。starter-actuator 负责暴露 /actuator/**，
		     micrometer-registry-prometheus 提供 /actuator/prometheus 这个抓取端点。
		     两个都要：只有 actuator 的话能看到指标名，但拿不到 Prometheus 格式的文本。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- 接口文档（OpenAPI 3 + Swagger UI）。
		     ⚠️ 版本必须跟 Spring Boot 的大版本走：springdoc 2.x 面向 Boot 3，
		     3.x 面向 Boot 4（3.1.1 的父 pom 就是 spring-boot-starter-parent:4.1.0）。
		     装 2.x 会以"Bean 创建失败 / 类找不到"的形式崩在启动阶段。
		     ⚠️ 它会暴露全部接口的面貌（路径、参数、DTO 字段），
		     而 /v3/api-docs 与 /swagger-ui 都不在 /api/** 下 —— 也就是**不受 JwtInterceptor 保护**。
		     生产部署请用 springdoc.api-docs.enabled=false 关掉，见 application.yml 的注释。 -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			  Maven Enforcer：把「这个项目需要什么环境」变成构建时就会失败的检查。
			
			  ⚠️ 为什么值得加：没有它的时候，用错 JDK / 用错 Maven 版本、
			  或者某个依赖树里出现两个版本的同名类，都只会在**运行到某一步**才以
			  「ClassNotFound / NoSuchMethodError / 行为诡异」的形式暴露 ——
			  而那时候没人会想到根因是构建环境。

			  requireJavaVersion 取 [17,)：与 pom 里的 java.version 一致，
			  但不写死上界 —— 用更高版本 JDK 编译应当被允许（实测 17 通过）。
			  dependencyConvergence 是这里面最有价值的一条：它要求同一个 artifact
			  在整棵依赖树里只能收敛到一个版本（详见 docs/开发规范.md）。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-build-environment</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[17,)</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
								<dependencyConvergence/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- 默认值来自 properties 里的 surefire.excludedGroups。
					     本地起好中间件后：mvn test -Dgroups=integration -Dsurefire.excludedGroups= -->
					<excludedGroups>${surefire.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
